{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f yarn.lock'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "node artifacts/api-server/dist/index.mjs",
    "dev": "pnpm -r --parallel --if-present run dev",
    "migrate": "pnpm --filter @workspace/db run migrate",
    "seed": "pnpm --filter @workspace/db run seed",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:seed": "pnpm --filter @workspace/db run seed",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate-data": "pnpm --filter @workspace/db run migrate:data",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}