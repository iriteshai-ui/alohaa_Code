{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "preinstall": "sh -c 'rm -f yarn.lock'",
    "build": "echo 'Prebuilt production bundle ready'",
    "start": "node server.js",
    "dev": "pnpm -r --parallel --if-present run dev",
    "migrate": "node --import tsx lib/db/src/migrate.ts",
    "seed": "node --import tsx lib/db/src/seed.ts",
    "db:migrate": "node --import tsx lib/db/src/migrate.ts",
    "db:seed": "node --import tsx lib/db/src/seed.ts"
  },
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "^3.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "bcrypt",
      "@swc/core"
    ]
  }
}